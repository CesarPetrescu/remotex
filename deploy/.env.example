# Copy this to .env and fill in the section for the ingress profile you use.
# Without an ingress profile, the relay is published only on 127.0.0.1:8080.

# Public hostname for the Caddy vhost (required for real TLS certs).
REMOTEX_HOSTNAME=relay.example.com

# Email passed to Let's Encrypt via Caddy for renewal notices.
ACME_EMAIL=you@example.com

# SparkTunnel public ingress (profile `sparktunnel`). Create a SparkTunnel
# site at webhost.photonspark.com and paste its one-time connector token here.
# Treat the token as a bearer secret and keep deploy/.env mode 0600.
# Uncomment COMPOSE_FILE to replace the base host publish with the secure
# loopback-only daemon endpoint, or pass both files explicitly as shown in
# deploy/README.md.
# COMPOSE_FILE=docker-compose.yml:docker-compose.sparktunnel.yml
SPARK_TUNNEL_TOKEN=
SPARK_TUNNEL_SERVER=https://webhost.photonspark.com
# This is a Docker-network URL, not a host port or public hostname.
SPARK_TUNNEL_TARGET=http://relay:8080

# Advanced: the connector image pins the verified 0.2.0 amd64 artifact.
# Change the URL and checksum together when upgrading the connector.
# SPARK_TUNNEL_DOWNLOAD_URL=https://webhost.photonspark.com/api/v1/downloads/spark-tunnel/linux/amd64
# SPARK_TUNNEL_SHA256=e57b3293f8c4dcb2a55e0a5fbd44e040e87b6b55be7b99222c287248e422d6b7

# Keep this at 0 for direct/local access. The SparkTunnel Compose override
# also forces 0 because SparkTunnel 0.2.0 does not provide a trustworthy
# visitor IP. Set it to 1 only behind Caddy or another proxy that overwrites
# caller-supplied X-Forwarded-For.
RELAY_TRUST_PROXY=0

# Optional: container timezone.
# TZ=Europe/Bucharest
# Keep daemon sessions alive this long after a web/mobile socket drops,
# so phone sleep, network switches, or browser reloads can reconnect.
# RELAY_CLIENT_RECONNECT_GRACE_SECONDS=75

# A session reserved via POST /api/sessions that no client ever attaches
# to is reaped after this many seconds (default 600).
# RELAY_SESSION_RESERVATION_TTL_SECONDS=600

# Largest file the relay will proxy through the browser/mobile file API,
# in bytes (default 26214400 = 25 MiB). The HTTP body limit and the
# WebSocket frame limit on both /ws/client and /ws/daemon are derived
# from this, so raising it raises per-connection memory too. The host
# daemon reads the same variable — keep the two in sync.
# REMOTEX_MAX_FILE_BYTES=26214400

# Seed the built-in demo user + bridge token on an empty database.
# LEAVE THIS OFF. The tokens are hardcoded in the public repo, so a relay
# that seeds them is a relay anyone on the internet can drive. Only set it
# to 1 on a throwaway box you are testing against.
RELAY_SEED_DEMO=0

# Local/direct deployments only: override the base relay's loopback host port.
# The SparkTunnel override replaces this with RELAY_LOCAL_HOST_PORT below.
# RELAY_HOST_PORT=18080

# SparkTunnel deployments retain a loopback-only endpoint for a daemon on
# this same machine. It is never reachable from the LAN or internet.
# RELAY_LOCAL_HOST_PORT=19080
# RELAY_HOST_BIND=0.0.0.0    # bind to all interfaces instead of loopback

# Postgres inventory store (users/hosts/sessions). The defaults match the
# bundled postgres service; only override if you change them there too.
# POSTGRES_DB=remotex
# POSTGRES_USER=remotex
# Generate a 256-bit deployment password with: openssl rand -hex 32
# POSTGRES_PASSWORD=change-me
